# ─────────────────────────────────────────────────────────────────────────
# ReloGo Landing (Next.js static export) — environment template
# Copy this file to `.env.local` and fill in your real values:
#     cp .env.example .env.local
#
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle, so put NOTHING
# secret here. The publishable key (or legacy anon key) is safe to ship — the
# waitlist signup goes through join_waitlist(), and RLS protects everything
# else.
# NEVER put the service_role key in this app.
#
# These are inlined at BUILD time (output: 'export'), so they must be present
# when you run `npm run build` for the deployed artifact (set them in Vercel's
# project env vars). CI supplies explicit placeholders; production must use
# the real public project values and fails fast if either variable is absent.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   • NEXT_PUBLIC_SUPABASE_ANON_KEY = publishable key (or legacy anon key)
# NEXT_PUBLIC_SITE_URL is the public origin used for canonical metadata,
# robots.txt, and sitemap.xml. Keep the working Vercel alias until a custom
# domain has been acquired, attached, and verified.
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://relogo-two.vercel.app
# Configure only after this public inbox is monitored and its deletion/support
# workflow has been tested. An empty value keeps the preview notice visible.
NEXT_PUBLIC_SUPPORT_EMAIL=
