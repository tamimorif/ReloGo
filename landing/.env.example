# ─────────────────────────────────────────────────────────────────────────
# ReloGo Landing (Next.js static export) — environment template
# Copy this file to `.env.local` and fill in your real values:
#     cp .env.example .env.local
#
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle, so put NOTHING
# secret here. The anon key is safe to ship — the waitlist signup goes through
# the join_waitlist() RPC, and RLS protects everything else.
# NEVER put the service_role key in this app.
#
# These are inlined at BUILD time (output: 'export'), so they must be present
# when you run `npm run build` for the deployed artifact (set them in Vercel's
# project env vars). The build also succeeds with placeholders for local dev.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   • NEXT_PUBLIC_SUPABASE_ANON_KEY = "Project API keys" → anon / public
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
