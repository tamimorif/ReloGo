# ─────────────────────────────────────────────────────────────────────────
# ReloGo Admin (Vite + React SPA) — environment template
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# Only VITE_* vars are exposed to the browser bundle, so put NOTHING secret
# here. The publishable key (or legacy anon key) is safe to ship; admin access
# is enforced server-side by the is_admin() RPC + RLS (migration 002), NOT by
# anything in this bundle.
# NEVER put the service_role key in this app.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • VITE_SUPABASE_URL      = "Project URL"
#   • VITE_SUPABASE_ANON_KEY = publishable key (or legacy anon key)
#
# To grant a user admin access, use a privileged database-owner session (for
# example, the Supabase SQL Editor) and follow docs/DEPLOYMENT.md's verified
# three-step procedure:
#   INSERT INTO public.admin_users (user_id)
#   SELECT id FROM auth.users WHERE email = 'you@example.com'
#   RETURNING user_id;
# ─────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
