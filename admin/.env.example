# ─────────────────────────────────────────────────────────────────────────
# ReloGo Admin (Vite + React SPA) — environment template
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# Only VITE_* vars are exposed to the browser bundle, so put NOTHING secret
# here. The anon key is safe to ship; admin access is enforced server-side by
# the is_admin() RPC + RLS (migration 002), NOT by anything in this bundle.
# NEVER put the service_role key in this app.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • VITE_SUPABASE_URL      = "Project URL"
#   • VITE_SUPABASE_ANON_KEY = "Project API keys" → anon / public
#
# To grant a user admin access, run this in the Supabase SQL editor
# (service_role context):
#   INSERT INTO admin_users (user_id)
#   SELECT id FROM auth.users WHERE email = 'you@example.com';
# ─────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
