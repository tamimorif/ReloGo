# ─────────────────────────────────────────────────────────────────────────
# ReloGo Worker (Python Playwright scraper) — environment template
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# ⚠️  This worker requires the service_role key. Its database access is
# restricted to source reads and the atomic persistence RPC. Keep the key SECRET:
# never commit a real .env or expose this key to mobile/admin/landing apps. In
# production (GitHub Actions cron — .github/workflows/worker.yml) set these as
# repo Actions secrets (Settings → Secrets and variables → Actions), not a
# committed file.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • SUPABASE_URL              = "Project URL"
#   • SUPABASE_SERVICE_ROLE_KEY = "Project API keys" → service_role (secret)
# ─────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Optional tuning (defaults shown) ──
# Per-action Playwright timeout, in milliseconds.
PAGE_TIMEOUT_MS=30000
# Page navigation (goto) timeout, in milliseconds.
NAV_TIMEOUT_MS=60000
# Maximum simultaneous source scrapes/downloads. Results are persisted in a
# deterministic order after all sources have been attempted.
SCRAPE_CONCURRENCY=8
# Maximum HTML body text returned from Playwright, in characters. Oversized
# pages are rejected before RPC persistence and retain their last known-good
# baseline. Values above the database hard ceiling are capped at 1,000,000.
MAX_HTML_TEXT_CHARS=1000000
# Maximum PDF download size, in bytes. PDF sources are downloaded as inert
# bytes and fingerprinted; oversized or invalid responses fail safely.
MAX_PDF_BYTES=26214400
# Minimum plausible page-body length, in characters. Shorter scrapes count as
# failed and never overwrite the stored baseline (guards against blank
# renders, bot walls, and error interstitials).
MIN_CONTENT_CHARS=200

# ── Optional notifications ──
# Slack-compatible incoming-webhook URL. When set, the worker POSTs a short
# JSON summary after any run that files new PENDING alerts or has failed
# sources. Leave unset to disable. In production, add it as the
# ALERT_WEBHOOK_URL repo Actions secret.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
