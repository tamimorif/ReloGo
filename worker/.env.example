# ─────────────────────────────────────────────────────────────────────────
# ReloGo Worker (Python Playwright scraper) — environment template
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# ⚠️  This is the ONLY component that uses the service_role key. It bypasses
# RLS to write rule_change_alerts. Keep this key SECRET — never commit a real
# .env, and never expose this key to the mobile/admin/landing apps. In
# production (Railway) set these as deployment env vars, not a committed file.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • SUPABASE_URL              = "Project URL"
#   • SUPABASE_SERVICE_ROLE_KEY = "Project API keys" → service_role (secret)
# ─────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Optional tuning (defaults shown) ──
# Per-action Playwright timeout, in milliseconds.
PAGE_TIMEOUT_MS=30000
# Page navigation (goto) timeout, in milliseconds.
NAV_TIMEOUT_MS=60000
