# ───────────────────────────────────────────────────────────────────────────
# ReloGo — root .gitignore (covers all apps: mobile/ admin/ landing/ worker/)
# Per-app .gitignore files add tool-specific entries on top of this.
# ───────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp/
.pnp.js

# Secrets — NEVER commit real env files. .env.example IS committed (template).
.env
.env.*
!.env.example
!**/.env.example

# Build output
dist/
build/
out/
.next/
.expo/
web-build/
*.tsbuildinfo

# Python (worker/)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~
.vercel
