{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://<your-project-ref>.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "<your-supabase-anon-key>"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
