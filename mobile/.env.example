# ─────────────────────────────────────────────────────────────────────────
# ReloGo Mobile (Expo) — environment template
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# Only EXPO_PUBLIC_* vars are exposed to the app bundle, so put NOTHING secret
# here. The publishable key (or legacy anon key) is safe to ship — Row Level
# Security protects the data.
# NEVER put the service_role key in this app.
#
# Where to find these: Supabase Dashboard → Project Settings → API
#   • EXPO_PUBLIC_SUPABASE_URL      = "Project URL"
#   • EXPO_PUBLIC_SUPABASE_ANON_KEY = publishable key (or legacy anon key)
#
# EAS builds do not read this local file. mobile/eas.json selects the EAS
# development/preview/production environment; ensure these two variables exist
# in each required EAS environment and keep preview/production projects separate.
# ─────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
